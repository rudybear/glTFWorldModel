# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
dist/
*.egg-info/

# project data / outputs (root-level only; does not affect src/gltfworld/data/).
# `/data/*` (not `/data/`) so the `!/data/README.md` negation below actually
# works -- git won't descend into a wholly-ignored directory to apply a
# negation pattern for a file inside it.
/data/*
!/data/README.md
/out/
/runs/

# generated glb assets, except checked-in golden fixtures
*.glb
!tests/goldens/**

# hypothesis example database
.hypothesis/
